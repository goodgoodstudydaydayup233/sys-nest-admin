# ====================================
# 项目公共环境变量配置
# 所有环境共享的基础配置
# ====================================

# 应用基本信息
VITE_APP_TITLE = sys-nest-admin
VITE_APP_VERSION = 1.0.0

# 应用基础路径（部署时的子路径）
VITE_BASE_URL = /

# 开发服务器端口
VITE_PORT = 5173

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT = 15000

# 是否启用 Mock 数据（开发调试用）
VITE_USE_MOCK = false

# 是否启用权限按钮控制
VITE_PERMISSION_BUTTON = true

# 默认主题模式（light / dark / auto）
VITE_DEFAULT_THEME = light

# 是否启用 PWA
VITE_PWA = false

# 是否启用 Gzip 压缩（仅生产环境生效）
VITE_GZIP = false

# 是否显示开发工具提示（生产环境建议关闭）
VITE_SHOW_TIPS = true

# 打包是否生成 source map（生产环境建议关闭或设为 hidden）
VITE_SOURCE_MAP = true

# 日志级别（debug / info / warn / error / silent）
VITE_LOG_LEVEL = info
