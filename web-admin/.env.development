# ====================================
# 开发环境配置
# 启动命令: pnpm dev 或 npm run dev
# ====================================

# 环境标识
NODE_ENV = development
VITE_APP_ENV = development

# API 接口基础地址（本地开发服务）
# ⚠️ 重要：使用相对路径 /dev-api，让 Vite 开发服务器代理转发到后端
# 这样可以自动解决 CORS 跨域问题，无需手动处理
VITE_API_BASE_URL = /dev-api

# Vite 代理目标地址（后端服务实际地址）
# 前端请求 /dev-api/* → 代理到 http://localhost:3000/dev-api/*
VITE_API_PROXY_TARGET = http://localhost:3000

# 是否启用 Vue DevTools
VITE_DEV_TOOLS = true

# 是否启用热重载
VITE_HMR = true

# 是否显示控制台详细日志
VITE_VERBOSE = true

# 是否启用 ESLint（开发时实时检查）
VITE_ESLINT = true

# 代理配置说明：
# 在 vite.config.ts 中已配置 /dev-api 代理到后端服务
# 前端请求 /dev-api/* → 代理到 http://localhost:3000/*
# 这样可以解决跨域问题，且无需在每个请求中写完整地址

# 开发环境特殊配置
VITE_MOCK_ENABLED = false
VITE_ERROR_LOG = true
