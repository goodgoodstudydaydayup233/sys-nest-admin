# ====================================
# 生产环境配置
# 构建命令: pnpm build:prod 或 npm run build:prod
# 预览命令: pnpm preview 或 npm run preview
# ====================================

# 环境标识
NODE_ENV = production
VITE_APP_ENV = production

# API 接口基础地址（生产环境 - 请替换为实际地址）
# 示例: https://api.yourdomain.com/prod-api
VITE_API_BASE_URL = /prod-api

# 是否启用 Vue DevTools（生产环境必须关闭）
VITE_DEV_TOOLS = false

# 是否启用性能监控
VITE_PERFORMANCE = true

# 是否显示控制台日志（生产环境建议关闭）
VITE_VERBOSE = false

# 是否启用错误上报（如 Sentry）
VITE_ERROR_REPORT = true

# CDN 地址（可选，用于静态资源加速）
# VITE_CDN_URL = https://cdn.yourdomain.com

# 生产环境特殊配置
VITE_MOCK_ENABLED = false
VITE_ERROR_LOG = false
VITE_SHOW_TIPS = false
VITE_SOURCE_MAP = false
