# ====================================
# 预发布环境配置（可选）
# 启动命令: pnpm dev:staging 或 npm run dev:staging
# 构建命令: pnpm build:staging 或 npm run build:staging
# ====================================

# 环境标识
NODE_ENV = production
VITE_APP_ENV = staging

# API 接口基础地址（预发布/测试服务器）
VITE_API_BASE_URL = https://test-api.yourdomain.com/admin

# 是否启用 Vue DevTools
VITE_DEV_TOOLS = false

# 是否启用性能监控
VITE_PERFORMANCE = true

# 是否显示控制台日志
VITE_VERBOSE = true

# 预发布环境特殊配置
VITE_MOCK_ENABLED = false
VITE_ERROR_LOG = true
VITE_SHOW_TIPS = true
VITE_SOURCE_MAP = true
